# Clerk → Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Supabase project settings → Settings → API
# (still using the anon key — auth now comes from Clerk's JWT, via Supabase's
# "Third Party Auth" Clerk integration, not Supabase's own auth.users)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Worker that handles image uploads (see worker/), once deployed
VITE_UPLOAD_WORKER_URL=https://frieda-images.<your-subdomain>.workers.dev
VITE_UPLOAD_SECRET=set-a-long-random-string-here
